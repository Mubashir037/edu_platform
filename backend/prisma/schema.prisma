generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum ExamType {
  MID1
  MID2
  FINAL
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
  GRADUATED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  isActive     Boolean  @default(true)

  student       Student?
  teacher       Teacher?
  parent        Parent?
  announcements Announcement[]
}

model Student {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  rollNo        Int      @unique
  classId       Int
  parentId      Int
  dob           DateTime
  admissionDate DateTime

  user        User         @relation(fields: [userId], references: [id])
  class       Class        @relation(fields: [classId], references: [id])
  parent      Parent       @relation(fields: [parentId], references: [id])
  attendances Attendance[]
  enrollments Enrollment[]
}

model Teacher {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  subject       String
  qualification String
  joiningDate   DateTime

  user        User         @relation(fields: [userId], references: [id])
  classes     Class[]
  attendances Attendance[]
  grades      Grade[]
  subjects    Subject[]
}

model Parent {
  id     Int @id @default(autoincrement())
  userId Int @unique

  user     User      @relation(fields: [userId], references: [id])
  students Student[]
}

model Class {
  id        Int @id @default(autoincrement())
  name      String
  teacherId Int

  teacher  Teacher   @relation(fields: [teacherId], references: [id])
  students Student[]
  subjects Subject[]
  enrollments Enrollment[]
}

model Subject {
  id      Int @id @default(autoincrement())
  name    String
  classId Int
  teacherId Int?

  class  Class   @relation(fields: [classId], references: [id])
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  grades Grade[]
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  date      DateTime
  status    String
  markedBy  Int
  enroll_id Int?

  student Student @relation(fields: [studentId], references: [id])
  teacher Teacher @relation(fields: [markedBy], references: [id])
  enrollment Enrollment? @relation(fields:[enroll_id],references:[id])
  @@unique([enroll_id,date])
}

model Grade {
  id           Int      @id @default(autoincrement())
  enrollmentId Int
  subjectId    Int
  examType     ExamType
  marks        Float
  markedBy     Int

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  subject    Subject    @relation(fields: [subjectId], references: [id])
  teacher    Teacher    @relation(fields: [markedBy], references: [id])

  @@unique([enrollmentId, subjectId, examType])
}

model Announcement {
  id         Int      @id @default(autoincrement())
  title      String
  body       String
  postedBy   Int
  targetRole Role
  createdAt  DateTime @default(now())

  user User @relation(fields: [postedBy], references: [id])
}
model academicsession{
  id Int @id@default(autoincrement())
  name String @unique
  startDate DateTime
  enddate DateTime
  isactive Boolean @default(false)
  closedAt DateTime?
  enrollments Enrollment[]
}
model Enrollment{
  id Int @id@default(autoincrement())
  studentId Int
  classId Int
  sessionId Int
  status EnrollmentStatus @default(ACTIVE)
  withdrawnAt DateTime?
  completedAt DateTime?

  student Student @relation(fields:[studentId],references:[id])
  class Class @relation(fields:[classId],references:[id])
  session academicsession @relation(fields:[sessionId],references:[id])
  attendances Attendance[]
  grades Grade[]

  @@unique([studentId,sessionId])

}
